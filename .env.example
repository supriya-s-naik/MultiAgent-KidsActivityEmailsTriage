# Nebius AI Studio (OpenAI-compatible endpoint) - used by classifier_agent / extractor_agent
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Discord channel webhook - used by notifier_agent to post the digest
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# Which Gmail MCP server main.py talks to: "mock" (sample data, default) or
# "real" (live Gmail API, requires mcp_server/token.json from gmail_auth_setup.py)
GMAIL_SOURCE=mock

# Gmail search query (real source only) - same syntax as the Gmail search box.
# Restrict to recent mail and/or known activity senders/keywords, e.g.:
#   newer_than:2d (from:coach.miller@northsideyouthsoccer.org OR from:*@lincolnelementary.edu OR subject:permission OR subject:RSVP)
GMAIL_QUERY=newer_than:1d

# Discord bot (used by bot.py for the on-demand /activity-check slash command,
# separate from the webhook above used by main.py's scheduled/manual run).
DISCORD_BOT_TOKEN=your_bot_token_here
# Optional: your server's ID, so the slash command syncs instantly there
# instead of waiting up to an hour for Discord's global command sync.
DISCORD_GUILD_ID=
